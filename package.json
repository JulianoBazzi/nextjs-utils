{
  "name": "@julianobazzi/nextjs-utils",
  "version": "1.1.0",
  "description": "A collection of reusable hooks and utilities for Next.js (App Router and Pages Router), compatible with React 18 and 19.",
  "author": "Juliano Bazzi",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.pt-br.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "nextjs",
    "next",
    "app-router",
    "pages-router",
    "react",
    "hooks",
    "nextjs-utils",
    "typescript"
  ],
  "homepage": "https://github.com/julianobazzi/nextjs-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianobazzi/nextjs-utils.git"
  },
  "bugs": {
    "url": "https://github.com/julianobazzi/nextjs-utils/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "release": "pnpm publish",
    "prepublishOnly": "pnpm build",
    "check:exports": "attw --pack . --profile node16"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "2.31.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.18.0"
}
